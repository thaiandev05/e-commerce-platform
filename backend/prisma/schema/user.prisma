model User {
    id              String         @id @default(uuid()) @db.Uuid
    fullname        String         @db.VarChar(50)
    username        String         @unique @db.VarChar(50)
    email           String         @unique @db.VarChar(255)
    phone           String?        @db.VarChar(20)
    hashingPassword String?        @map("hashing_password") @db.VarChar(255)
    accountType     AccountType    @default(EMAIL) @map("account_type")
    avatarUrl       String?        @map("avatar_url") @db.VarChar(500)
    address         String?        @db.VarChar(500)
    city            String?        @db.VarChar(50)
    state           String?        @db.VarChar(50)
    searchCount     Int            @default(0) @map("search_times")
    createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz()
    updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz()
    visible         UserVisibility @default(PUBLIC)
    status          Status         @default(ACTIVE)
    numberIdentify  String?
    isBanned        Boolean        @default(false) @map("is_banned")
    isLocked        Boolean        @default(false) @map("is_locked")
    isVerified      Boolean        @default(false) @map("is_verified")
    lastActived     DateTime?      @map("last_actived") @db.Timestamptz()

    // relation
    roles      UserRole[]
    flags      UserFlag[]
    sessions   Session[]    @relation("sessions")
    codes      Code?
    Oauth2User Oauth2User[] @relation("oauth2")
    shops      Shop[]
    CreditCard CreditCard[] @relation("payments")
    cart       Cart?        @relation("ownCart")
    Vouchers   Voucher[]
    Order      Order[]
    clients    Room[]       @relation("client")
    supports   Room[]       @relation("support")
    sender     Message[]    @relation("sender")
    receiver   Message[]    @relation("receiver")

    @@index([email])
    @@index([username])
}

model Oauth2User {
    id             String   @id @default(uuid()) @db.Uuid
    provider       Provider
    providerUserId String   @map("provider_user_id") @db.VarChar(500)
    email          String   @unique @db.VarChar(255)
    phone          String?  @db.VarChar(20)
    firstname      String?  @db.VarChar(50)
    lastname       String?  @db.VarChar(50)
    fullname       String?  @db.VarChar(50)
    avatarUrl      String?  @map("avatar_url") @db.VarChar(500)
    username       String?  @db.VarChar(50)
    createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
    updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz()

    userId String @map("user_id") @db.Uuid
    user   User   @relation(name: "oauth2", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@map("oauth2_user")
}

model CreditCard {
    id           String   @id @default(uuid()) @db.Uuid
    creditNumber String   @unique @map("credit_number") @db.VarChar(100)
    expiredDate  DateTime @map("expired_date") @db.Timestamptz()
    ccvSecure    String   @map("ccv_secure") @db.VarChar(10)
    name         String   @map("name_on_card") @db.VarChar(255)
    address      String   @db.VarChar(500)
    postalCode   String   @map("postal_code") @db.VarChar(20)

    userId String @map("user_id") @db.Uuid
    user   User   @relation("payments", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
    updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

    @@index([userId])
    @@map("credit_card")
}

model Voucher {
    id              String   @id @default(uuid()) @db.Uuid
    categoryId      String   @map("category_id") @db.Uuid
    percentDisCount Float    @map("percent_discount")
    createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
    expiredAt       DateTime @map("expired_at") @db.Timestamptz()

    // foreign key
    ownId String @map("own_id") @db.Uuid

    // relation
    own         User          @relation(fields: [ownId], references: [id], onDelete: Cascade)
    voucherUsed VoucherUsed[]

    @@map("voucher")
}

model Order {
    id            String        @id @default(uuid()) @db.Uuid
    typeOfPayment TypeOfPayment @default(INPERSON) @map("type_of_payment")
    statusOrder   StatusOrder   @default(PENDING) @map("status_order")
    createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz()
    updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz()
    price         Decimal?      @map("sale_price") @db.Decimal(12, 2)
    quantity      Int           @default(1) @map("quantity")
    // foreign key
    ownId         String        @db.Uuid

    // relation
    VoucherUsed  VoucherUsed[]
    OrderProduct OrderProduct[]
    own          User           @relation(fields: [ownId], references: [id], onDelete: Cascade)

    @@map("order")
}

model OrderProduct {
    id        String   @id @default(uuid()) @db.Uuid
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

    // foreign key
    productId String @map("product_id") @db.Uuid
    orderId   String @map("order_id") @db.Uuid
    shopId    String @map("shop_id") @db.Uuid
    // relation
    sku       Sku    @relation(fields: [productId], references: [id], onDelete: Cascade)
    order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
    shop      Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

    @@map("order_product")
}

model VoucherUsed {
    id        String   @id @default(uuid()) @db.Uuid
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

    // foreign key
    voucherId String @map("voucher_id") @db.Uuid
    orderId   String @map("order_id") @db.Uuid

    // relation
    voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
    order   Order   @relation(fields: [orderId], references: [id])

    @@map("voucher_used")
}

enum TypeOfPayment {
    ONLINE
    INPERSON

    @@map("type_payment")
}

enum StatusOrder {
    PENDING
    RECEIVED
    CANCEL
    INPROCESS
}

enum UserRoleS {
    ROOT
    ADMINSTRATOR
    SUPPORTER
    COLLABORATOR
    SELLER
    USER

    @@map("user_role")
}

enum UserFlag {
    BEST_CUSTOMER
    DIAMOND_CUSTOMER
    GOLD_CUSTOMER
    SILVER_CUSTOMER
    COPPER_CUSTOMER
    CUSTOMER

    @@map("user_flag")
}

enum UserVisibility {
    PUBLIC
    PRIVATE
    CONTACT_ONLY

    @@map("user_visibility")
}

enum Provider {
    FACEBOOK
    GOOGLE
}

enum Status {
    ACTIVE
    SOFTDELETE
    PENDING
}
